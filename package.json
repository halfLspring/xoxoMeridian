{
  "name": "xoxo-meridian",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:dev-origins": "playwright test --config playwright.dev-origins.config.ts",
    "test:e2e:public": "playwright test --project=public",
    "test:e2e:production": "E2E_APP_MODE=production npm run test:e2e",
    "test:compose-smoke": "node --import tsx scripts/compose-deployment-smoke.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:static": "npm run check:agent-entry-assets && npm run typecheck && npm run lint",
    "check:quick": "npm run check:static && npm test",
    "check:compose-config": "node --import tsx scripts/compose-deployment-smoke.ts --config-only",
    "check": "npm run check:static && npm run test:coverage && npm run build",
    "check:full": "npm run check && npm run test:integration && npm run test:e2e:production",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "agent:worker": "tsx agent/agent-worker.ts",
    "agent-entry:assets": "node --import tsx scripts/agent-entry-assets.ts",
    "check:agent-entry-assets": "npm run agent-entry:assets -- check",
    "test:e2e:agent-entry:production:default": "E2E_APP_MODE=production E2E_SOFTWARE_WEBGL=true NEXT_PUBLIC_AGENT_ENTRY_THEME=default playwright test tests/e2e/agent-entry-public.spec.ts tests/e2e/agent-entry-authenticated.spec.ts",
    "test:e2e:agent-entry:production:birthday": "E2E_APP_MODE=production E2E_SOFTWARE_WEBGL=true NEXT_PUBLIC_AGENT_ENTRY_THEME=birthday-2026 playwright test tests/e2e/agent-entry-public.spec.ts tests/e2e/agent-entry-authenticated.spec.ts",
    "blog:assets:cleanup": "tsx scripts/cleanup-blog-assets.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/nodemailer": "^8.0.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "city-timezones": "^1.3.4",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.22.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "pinyin-pro": "^3.28.1",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@playwright/test": "1.62.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "^29.1.1",
    "meshoptimizer": "1.2.0",
    "msw": "^2.15.0",
    "prisma": "^5.22.0",
    "sharp": "0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
