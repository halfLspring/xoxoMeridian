generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SenderType {
  human
  agent
  system
}

enum RoomKind {
  shared
  agent_private
}

enum TargetType {
  all
  user
  agent
}

enum MessageStatus {
  sent
  processing
  failed
}

enum AgentTaskStatus {
  pending
  running
  waiting_approval
  completed
  failed
  cancelled
  limit_exceeded
}

enum AgentTaskLimitReason {
  max_turns
  max_tool_calls
  max_runtime
  max_tokens
  max_cost
}

enum ToolCallStatus {
  running
  completed
  failed
}

enum LLMCallStatus {
  running
  completed
  failed
}

enum AgentToolRisk {
  low
  medium
  high
}

enum AgentToolApprovalStatus {
  pending
  approved
  rejected
}

enum AgentStepKind {
  plan
  tool
  final
}

enum AgentStepStatus {
  pending
  running
  waiting_approval
  completed
  failed
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  displayName    String
  avatarLabel    String
  passwordHash   String
  sessionVersion Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profile        UserProfile?
  participants   RoomParticipant[]
  agentConversation Room?          @relation("AgentConversationOwner")
  messages       Message[]
  requestedTasks AgentTask[]       @relation("RequestedTasks")
  memos          Memo[]

  eventLogs             EventLog[]
  memories              Memory[]
  scheduledJobs         ScheduledJob[]
  blogWorks             BlogWork[]
  blogMediaAssets       BlogMediaAsset[]
  atlasElements         AtlasElement[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  posts                 Post[]
  focusState            FocusState?
  focusSessions         FocusSession[]
  studyGoals            StudyGoal[]
  toolApprovalDecisions AgentToolApproval[]  @relation("ToolApprovalDecision")
}

model Session {
  id        String   @id
  userId    String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  tokenDigest String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  city         String
  country      String
  timezone     String
  geoSource    String    @default("auto")
  lastGeoCheck DateTime?
  lastGeoIp    String?
  preferences  Json?
  profileNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String?
  kind             RoomKind          @default(shared)
  privateOwnerId   String?           @unique
  privateOwner     User?             @relation("AgentConversationOwner", fields: [privateOwnerId], references: [id], onDelete: Cascade)
  maxHumanUsers    Int               @default(2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  participants     RoomParticipant[]
  messages         Message[]
  agentTasks       AgentTask[]
  memos            Memo[]
  messageSummaries MessageSummary[]
  memories         Memory[]
  eventLogs        EventLog[]
  scheduledJobs    ScheduledJob[]
  posts            Post[]
  focusStates      FocusState[]
  focusSessions    FocusSession[]
  studyGoals       StudyGoal[]
}

model RoomParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id            String        @id @default(cuid())
  roomId        String
  senderId      String?
  senderAgentId String?
  senderType    SenderType
  content       String
  clientMessageId String?
  targetType    TargetType    @default(all)
  targetId      String?
  status        MessageStatus @default(sent)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender        User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderAgent   Agent?        @relation(fields: [senderAgentId], references: [id], onDelete: SetNull)
  sourceTask    AgentTask?    @relation("SourceMessage")
  finalTask     AgentTask?    @relation("FinalMessage")

  @@index([roomId, createdAt])
  @@unique([roomId, senderId, clientMessageId])
  @@index([senderId])
  @@index([senderAgentId])
}

model Agent {
  id            String         @id @default(cuid())
  slug          String         @unique
  displayName   String
  description   String
  enabled       Boolean        @default(true)
  config        Json?
  systemPrompt  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         AgentTask[]
  messages      Message[]
  scheduledJobs ScheduledJob[]
}

model AgentTask {
  id              String              @id @default(cuid())
  roomId          String
  agentId         String
  sourceMessageId String?             @unique
  requestedById   String?
  status          AgentTaskStatus     @default(pending)
  input           Json
  plan            Json?
  result          Json?
  error           String?
  retryCount      Int                 @default(0)
  maxTurns        Int                 @default(16)
  maxToolCalls    Int                 @default(64)
  maxRuntimeMs    Int                 @default(86400000)
  maxTokens       Int                 @default(1000000)
  maxCostMicros   Int                 @default(20000000)
  maxCompletionTokens Int             @default(8192)
  inputCostMicrosPerMillionTokens Int  @default(1000000)
  outputCostMicrosPerMillionTokens Int @default(4000000)
  turnsUsed       Int                 @default(0)
  toolCallsUsed   Int                 @default(0)
  tokensUsed      Int                 @default(0)
  costUsedMicros  Int                 @default(0)
  deadlineAt      DateTime?
  limitReason     AgentTaskLimitReason?
  attemptCount    Int                 @default(0)
  attemptId       String?
  workerId        String?
  heartbeatAt     DateTime?
  leaseExpiresAt  DateTime?
  currentStepKey  String?
  startedAt       DateTime?
  completedAt     DateTime?
  finalMessageId  String?             @unique
  // 时间线投影的终态决策时间：非空表示该任务的时间线条目已创建或按节流规则判定为不创建。
  timelineProjectedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  room            Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent           Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sourceMessage   Message?            @relation("SourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  requestedBy     User?               @relation("RequestedTasks", fields: [requestedById], references: [id], onDelete: SetNull)
  finalMessage    Message?            @relation("FinalMessage", fields: [finalMessageId], references: [id], onDelete: SetNull)
  timelinePost    Post?
  toolCalls       ToolCall[]
  llmCalls        LLMCall[]
  eventLogs       EventLog[]
  memos           Memo[]
  toolApprovals   AgentToolApproval[]
  steps           AgentStep[]

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt, createdAt])
  @@index([status, timelineProjectedAt])
  @@index([roomId])
  @@index([agentId])
}

model AgentStep {
  id           String          @id @default(cuid())
  taskId       String
  stepKey      String
  kind         AgentStepKind
  status       AgentStepStatus @default(pending)
  input        Json?
  output       Json?
  error        String?
  errorCategory String?
  attemptCount Int             @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  task         AgentTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepKey])
  @@index([taskId, status])
}

model ToolCall {
  id         String         @id @default(cuid())
  taskId     String
  stepKey    String?
  toolName   String
  input      Json?
  output     Json?
  status     ToolCallStatus @default(running)
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  durationMs Int?
  error      String?
  createdAt  DateTime       @default(now())
  task       AgentTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepKey])
  @@index([taskId])
  @@index([toolName])
}

model AgentToolApproval {
  id          String                  @id @default(cuid())
  taskId      String
  stepKey     String
  toolName    String
  risk        AgentToolRisk
  input       Json
  status      AgentToolApprovalStatus @default(pending)
  decidedById String?
  requestedAt DateTime                @default(now())
  decidedAt   DateTime?
  task        AgentTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decidedBy   User?                   @relation("ToolApprovalDecision", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([taskId, stepKey])
  @@index([status, requestedAt])
  @@index([decidedById])
}

model LLMCall {
  id               String        @id @default(cuid())
  taskId           String
  provider         String
  model            String
  turnIndex        Int?
  inputSummary     String
  requestPayload   Json?
  responsePayload  Json?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  reservedTokens   Int           @default(0)
  reservedCostMicros Int         @default(0)
  costMicros       Int?
  status           LLMCallStatus
  error            String?
  durationMs       Int?
  createdAt        DateTime      @default(now())
  task             AgentTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, turnIndex])
  @@index([taskId])
}

model Memo {
  id          String     @id @default(cuid())
  roomId      String
  createdById String?
  agentTaskId String?
  title       String
  content     String
  pinned      Boolean    @default(false)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  agentTask   AgentTask? @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model MessageSummary {
  id            String   @id @default(cuid())
  roomId        String
  rangeStartId  String?
  rangeEndId    String?
  summary       String
  type          String   @default("range")
  messageCount  Int?
  tokenEstimate Int?
  createdAt     DateTime @default(now())
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, type])
}

model Memory {
  id        String   @id @default(cuid())
  roomId    String
  userId    String?
  ownerKey  String
  key       String
  value     String
  source    String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([roomId, ownerKey, key])
  @@index([userId])
}

model EventLog {
  id          String     @id @default(cuid())
  roomId      String?
  actorUserId String?
  agentTaskId String?
  type        String
  payload     Json?
  createdAt   DateTime   @default(now())
  room        Room?      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actorUser   User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  agentTask   AgentTask? @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([agentTaskId, createdAt])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  roomId      String
  agentId     String
  cron        String
  timezone    String    @default("UTC")
  payload     Json
  enabled     Boolean   @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  failCount   Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([enabled, nextRunAt])
  @@index([roomId])
}

enum AtlasElementType {
  photo
  note
}

enum PostType {
  user_post
  agent_log
}

model AtlasBoard {
  id          String            @id @default(cuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  works       BlogWork[]
  elements    AtlasElement[]
  connections AtlasConnection[]
}

model AtlasElement {
  id              String            @id @default(cuid())
  boardId         String
  type            AtlasElementType
  x               Float
  y               Float
  rotation        Float             @default(0)
  zIndex          Int               @default(0)
  content         String?
  imageUrl        String?
  caption         String?
  width           Float             @default(200)
  height          Float             @default(250)
  workId          String?
  mediaAssetId    String?           @unique
  work            BlogWork?         @relation(fields: [workId], references: [id], onDelete: Cascade)
  mediaAsset      BlogMediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  postId          String?           @unique
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  board           AtlasBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  post            Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  connectionsFrom AtlasConnection[] @relation("FromElement")
  connectionsTo   AtlasConnection[] @relation("ToElement")

  @@index([workId])
  @@index([boardId, x, y])
  @@index([boardId, zIndex])
}

model AtlasConnection {
  workId    String?
  work      BlogWork?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  updatedAt DateTime     @updatedAt
  id        String       @id @default(cuid())
  boardId   String
  fromId    String
  toId      String
  color     String       @default("#8B7355")
  createdAt DateTime     @default(now())
  board     AtlasBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fromEl    AtlasElement @relation("FromElement", fields: [fromId], references: [id], onDelete: Cascade)
  toEl      AtlasElement @relation("ToElement", fields: [toId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@unique([boardId, fromId, toId])
  @@index([boardId])
}

model Post {
  workId         String?
  workOrder      Int?
  work           BlogWork?     @relation(fields: [workId], references: [id], onDelete: Cascade)
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  content        String // Markdown
  type           PostType      @default(user_post)
  authorId       String?
  roomId         String?
  authorCity     String?
  authorCountry  String?
  authorTimezone String?
  publishedAt    DateTime?
  metadata       Json?
  // Agent 时间线投影的幂等键：一个 AgentTask 至多一条派生 Post。
  agentTaskId    String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  agentTask      AgentTask?    @relation(fields: [agentTaskId], references: [id], onDelete: SetNull)
  atlasElement   AtlasElement?

  @@unique([workId, workOrder])
  @@index([type, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([roomId])
}

enum FocusStatus {
  idle
  focusing
  running
  paused
}

enum StudyTimerMode {
  focus
  short
  long
}

enum FocusSessionStatus {
  completed
  cancelled
}

model FocusState {
  id                String         @id @default(cuid())
  userId            String         @unique
  status            FocusStatus    @default(idle)
  mode              StudyTimerMode @default(focus)
  plannedMinutes    Int
  remainingSeconds  Int?
  startedAt         DateTime?
  expectedEndAt     DateTime?
  pausedAt          DateTime?
  lastStudySeenAt   DateTime?
  currentSessionKey String?
  roomId            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  room              Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([roomId])
  @@index([lastStudySeenAt])
}

model FocusSession {
  id             String             @id @default(cuid())
  userId         String
  sessionKey     String
  roomId         String?
  status         FocusSessionStatus @default(completed)
  mode           StudyTimerMode     @default(focus)
  plannedMinutes Int
  actualMinutes  Int
  startedAt      DateTime
  endedAt        DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  room           Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionKey])
  @@index([userId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([roomId])
  @@index([status, startedAt(sort: Desc)])
  @@index([mode, status, startedAt(sort: Desc)])
}

model StudyGoal {
  id        String   @id @default(cuid())
  userId    String
  roomId    String?
  localDate String
  text      String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId, localDate, sortOrder])
  @@index([roomId, localDate])
}


enum BlogWorkStatus {
  draft
  published
}

enum BlogMediaStatus {
  pending
  ready
  cleanup
}

model BlogWork {
  id             String         @id @default(cuid())
  boardId        String
  ownerId        String
  status         BlogWorkStatus @default(draft)
  publishedAt    DateTime?
  revision       Int            @default(0)
  draftX         Float          @default(0)
  draftY         Float          @default(0)
  viewportX      Float          @default(0)
  viewportY      Float          @default(0)
  viewportWidth  Float          @default(960)
  viewportHeight Float          @default(540)
  layoutWidth    Float          @default(960)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  board          AtlasBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  posts          Post[]
  elements       AtlasElement[]
  connections    AtlasConnection[]
  assets         BlogMediaAsset[]

  @@unique([boardId, id])
  @@index([ownerId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
}

model BlogWorkMutation {
  id          String   @id @default(cuid())
  actorId     String
  mutationId  String
  workId      String
  operation   String
  inputHash   String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([actorId, mutationId])
  @@index([createdAt])
}

model BlogMediaAsset {
  id               String          @id @default(cuid())
  storageKey       String          @unique
  ownerId          String?
  workId           String?
  uploadMutationId String
  contentType      String
  size             Int
  status           BlogMediaStatus @default(pending)
  expiresAt        DateTime
  cleanupAttempts  Int             @default(0)
  nextRetryAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  owner            User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  work             BlogWork?       @relation(fields: [workId], references: [id], onDelete: SetNull)
  element          AtlasElement?

  @@index([status, expiresAt])
  @@index([workId])
}
